# Copiază în .env și completează. .env nu intră în git.

# Parola bazei de date (doar internă, între containere).
POSTGRES_PASSWORD=schimba-ma

# Interfața web, publicată doar pe 127.0.0.1 (din exterior: tunel + Cloudflare Access).
WEB_LOCAL_PORT=8080

# Colectare
# Interval între rulări, în minute (se alege aleator între min și max).
INTERVAL_MIN_MINUTES=30
INTERVAL_MAX_MINUTES=60
# Pagini de rezultate citite la o rulare normală și la recuperare (după sleep sau la pornire).
PAGES_NORMAL=2
PAGES_CATCHUP=6
# Pauză între două cereri către același site, în secunde.
REQUEST_DELAY_MIN=4
REQUEST_DELAY_MAX=9
# Reverificarea anunțurilor potrivite care nu mai apar în căutare: după câte ore și câte pe rulare.
RECHECK_AFTER_HOURS=24
RECHECK_PER_RUN=10
# OpenStreetMap: anul construcției din clădirile cartografiate (câte locații noi pe rulare; 0 = deloc).
OSM_LOOKUPS_PER_RUN=5
# Fusul orar în care interfața afișează datele.
TIMEZONE=Europe/Bucharest
# Curs folosit pentru anunțurile în lei.
EUR_RON=4.97
LOG_LEVEL=INFO
