# Copiază în .env și completează. .env nu intră în git.

# Parola bazei de date (doar internă, între containere).
POSTGRES_PASSWORD=schimba-ma

# ntfy
# Adresa publică a serverului ntfy (de exemplu prin Cloudflare Tunnel).
NTFY_PUBLIC_URL=https://ntfy.example.com
NTFY_LOCAL_PORT=8090
# Token creat cu: docker compose exec ntfy ntfy token add <utilizator>
NTFY_TOKEN=
# Topicul pe care te abonezi din aplicația de pe telefon.
NTFY_TOPIC=apartamente

# Email (opțional, ca al doilea canal). Lasă SMTP_HOST gol ca să-l dezactivezi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Colectare
# Interval între rulări, în minute (se alege aleator între min și max).
INTERVAL_MIN_MINUTES=30
INTERVAL_MAX_MINUTES=60
# Pagini de rezultate citite la o rulare normală și la recuperare (după sleep sau la pornire).
PAGES_NORMAL=2
PAGES_CATCHUP=6
# Pauză între două cereri către același site, în secunde.
REQUEST_DELAY_MIN=4
REQUEST_DELAY_MAX=9
# Curs folosit pentru anunțurile în lei.
EUR_RON=4.97
LOG_LEVEL=INFO
